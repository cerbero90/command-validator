{
    "name": "cerbero/command-validator",
    "type": "library",
    "description": "Laravel package to validate the input of console commands.",
    "keywords": [
        "laravel",
        "console",
        "validation",
        "command-line"
    ],
    "homepage": "https://github.com/cerbero90/command-validator",
    "license": "MIT",
    "authors": [{
        "name": "Andrea Marco Sartori",
        "email": "andrea.marco.sartori@gmail.com",
        "homepage": "https://github.com/cerbero90",
        "role": "Developer"
    }],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": ">=11.0",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": ">=9.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^1.9",
        "squizlabs/php_codesniffer": "^3.0",
        "tightenco/duster": "^2.0",
        "uma/ocular": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Cerbero\\CommandValidator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cerbero\\CommandValidator\\": "tests"
        }
    },
    "scripts": {
        "fix": "duster fix -u tlint,phpcodesniffer,pint",
        "lint": "duster lint -u tlint,phpcodesniffer,pint,phpstan",
        "test": "pest"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
